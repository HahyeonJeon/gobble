{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": [
    "scripts/**/*.ts",
    "contracts/scripts/**/*.ts",
    "contracts/tests/**/*.ts",
